// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRADOR
  GESTOR_MOBILIDADE
  ESTUDANTE
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  password  String
  perfil    UserRole

  universityId  String?
  university    University? @relation(fields: [universityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model University {
  id        String   @id @default(cuid())
  nome      String
  pais      String

  users User[]
  mobilities Mobility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mobility {
  id            String   @id @default(cuid())
  ano           Int
  semestre      Int      @default(1)
  enviados      Int
  recebidos     Int

  universityId  String
  students      MobilityStudent[]
  university    University @relation(fields: [universityId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MobilityStudent{
  id                  String @id @default(uuid())
  matricula           String
  nome                String
  email               String
  paisOrigem          String
  paisDestino         String
  tipoMobilidade      String @default("ENVIADO")
  cursoOrigem         String
  cursoDestino        String
  universidadeOrigem  String @default("")
  universidadeDestino String

  mobilityId          String
  mobility            Mobility @relation(fields: [mobilityId], references: [id])
}